{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo.node"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "electron.vite.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "tests/unit/**/*"
  ]
}
